#!/bin/sh
# Style checks on the commits being pushed (GitHub Actions doesn't run them).
# Turn it on once per clone: git config core.hooksPath .githooks

fix='bunx biome check --write'

checks() {
    check bun run lint
}

# --- the same in every repo from here ---

set -u
common=$(cd "$(git rev-parse --git-common-dir)" && pwd)
main=$(dirname "$common")
top=$(git rev-parse --show-toplevel)
checked="$common/pre-push-checked"
tmp=

# Run one check and carry on, so a push shows every failure at once.
check() {
    "$@" || failed=1
}

# A Python tool at its uv.lock version, the one `uv sync --frozen` installs.
locked() {
    tool=$1
    shift
    version=$(awk -v name="name = \"$tool\"" '$0 == name { getline; gsub(/"/, "", $3); print $3; exit }' uv.lock)
    if [ -z "$version" ]; then
        echo "pre-push: $tool is not in uv.lock" >&2
        return 1
    fi
    uvx --quiet --from "$tool==$version" "$tool" "$@"
}

# vendor/ and node_modules/ aren't in git, so borrow them from this checkout or the main one.
link_deps() {
    for dep in vendor node_modules; do
        [ -e "$tmp/$dep" ] && continue
        for dir in "$top" "$main"; do
            if [ -d "$dir/$dep" ]; then
                ln -s "$dir/$dep" "$tmp/$dep"
                break
            fi
        done
    done
}

cleanup() {
    [ -n "$tmp" ] || return 0
    for dep in vendor node_modules; do
        if [ -L "$tmp/$dep" ]; then rm "$tmp/$dep"; fi
    done
    git worktree remove --force "$tmp"
    tmp=
}
trap 'cleanup; exit 1' INT TERM

status=0
while read -r _ sha _ _; do
    # A deleted ref sends all zeros, which isn't a commit.
    commit=$(git rev-parse --verify --quiet "$sha^{commit}") || continue
    # Pushing the same commit to the next remote doesn't check it again.
    grep -qsx "$commit" "$checked" && continue

    # Check the commit itself, not the working tree: uncommitted files don't go out.
    # The same folder every time keeps pint's cache (keyed by path) warm; a parallel push gets its own.
    tmp="${TMPDIR:-/tmp}/pre-push-$(printf %s "$common" | cksum | cut -d' ' -f1)"
    if ! git worktree add --quiet --force --detach "$tmp" "$commit" 2>/dev/null; then
        tmp=$(mktemp -d "${TMPDIR:-/tmp}/pre-push.XXXXXX")
        if ! git worktree add --quiet --detach "$tmp" "$commit"; then
            rmdir "$tmp"
            tmp=
            status=1
            continue
        fi
    fi
    link_deps
    if (cd "$tmp" && unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE && failed=0 && checks && exit $failed) </dev/null; then
        echo "$commit" >>"$checked"
    else
        echo >&2
        echo "pre-push: style checks failed on $(git rev-parse --short "$commit"). Fix with: $fix" >&2
        echo "pre-push: commit the fix and push again (git push --no-verify skips the checks)." >&2
        status=1
    fi
    cleanup
done
exit $status
