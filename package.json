{
  "name": "@felipehertzer/tributejs",
  "version": "6.2.8",
  "description": "Native ES6 @mentions",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/tribute.mjs",
      "default": "./dist/tribute.mjs"
    },
    "./tribute.css": "./dist/tribute.css"
  },
  "type": "module",
  "module": "./dist/tribute.mjs",
  "types": "./dist/index.d.ts",
  "style": "./dist/tribute.css",
  "files": [
    "dist"
  ],
  "packageManager": "bun@1.4.2",
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^26.6.2",
    "@vitest/browser-playwright": "^5.0.1",
    "@vitest/coverage-v8": "^5.0.1",
    "git-cliff": "^2.14.2",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/felipehertzer/tribute.git"
  },
  "scripts": {
    "prebuild": "bun run clean",
    "build": "bun run typecheck && vite build && vite build --mode minified && bun run build:types",
    "build:types": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.node.json",
    "start": "bun run build && vite --host 127.0.0.1 --open /example/",
    "clean": "node script/clean.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "dagger": "dagger ./dagger.sh",
    "lint": "biome check",
    "format": "biome format --write ./src",
    "release_note": "git-cliff --latest --strip header",
    "prepublishOnly": "bun run build"
  },
  "author": "Jordan Humphreys <jordan@zurb.com>",
  "license": "MIT"
}
