{
  "name": "@felipehertzer/tributejs",
  "version": "6.2.7",
  "description": "Native ES6 @mentions",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/tribute.mjs",
      "default": "./dist/tribute.mjs"
    },
    "./tribute.css": "./dist/tribute.css"
  },
  "type": "module",
  "module": "./dist/tribute.mjs",
  "types": "./dist/index.d.ts",
  "style": "./dist/tribute.css",
  "files": [
    "dist"
  ],
  "packageManager": "npm@11.17.0",
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/node": "^26.4.1",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "chai": "^6.2.2",
    "git-cliff": "^2.13.1",
    "glob": "^13.0.6",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/felipehertzer/tribute.git"
  },
  "scripts": {
    "prebuild": "npm run clean",
    "build": "npm run typecheck && vite build && vite build --mode minified && npm run build:types",
    "build:types": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.node.json",
    "start": "npm run build && vite --host 127.0.0.1 --open /example/",
    "clean": "node script/clean.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "dagger": "dagger ./dagger.sh",
    "lint": "biome check",
    "format": "biome format --write ./src",
    "release_note": "npx git-cliff --latest --strip header",
    "prepublishOnly": "npm run build"
  },
  "author": "Jordan Humphreys <jordan@zurb.com>",
  "license": "MIT"
}
