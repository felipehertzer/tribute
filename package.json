{
  "name": "@felipehertzer/tributejs",
  "version": "6.2.6",
  "description": "Native ES6 @mentions",
  "exports": {
    ".": {
      "import": "./dist/tribute.mjs",
      "types": "./dist/index.d.ts"
    }
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@web/dev-server-esbuild": "^1.0.5",
    "@web/test-runner": "^0.20.2",
    "@web/test-runner-commands": "^0.9.0",
    "@web/test-runner-playwright": "^0.11.1",
    "chai": "^6.2.2",
    "git-cliff": "^2.13.1",
    "glob": "^13.0.6",
    "rollup": "^4.60.3",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-livereload": "^2.0.5",
    "rollup-plugin-serve": "^3.0.0",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "playwright": "1.56.1",
    "playwright-core": "1.56.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/felipehertzer/tribute.git"
  },
  "scripts": {
    "build": "rollup -c",
    "start": "rollup -c -w",
    "clean": "node script/clean.js",
    "test": "web-test-runner --node-resolve --playwright --browsers chromium",
    "test:coverage": "web-test-runner --node-resolve --playwright --browsers chromium --coverage",
    "dagger": "dagger ./dagger.sh",
    "lint": "biome check",
    "format": "biome format --write ./src",
    "release_note": "npx git-cliff --latest --strip header",
    "prepublishOnly": "npm run build"
  },
  "author": "Jordan Humphreys <jordan@zurb.com>",
  "license": "MIT"
}
